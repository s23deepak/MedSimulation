# MedSimulation — Modal Deployment Environment Variables
# Copy this file to .env.modal and fill in your values
# modal_app.py will automatically load these via Secret.from_dotenv()

# ═══════════════════════════════════════════════════════════════════════════════
# LLM Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ── GPU Mode (vLLM with local model on Modal GPU) ──────────────────────────────
# Default: Uses google/medgemma-4b-it on the Modal GPU

# Model to use (change if you want a different model)
VLLM_MODEL=google/medgemma-4b-it

# GPU memory utilization (0.5-0.95, higher = more memory for model, less for KV cache)
VLLM_GPU_MEMORY=0.7

# Maximum context length
VLLM_MAX_MODEL_LEN=4096

# Quantization: "bitsandbytes" or "none"
VLLM_QUANTIZATION=bitsandbytes

# ── Cloud Mode (use Together AI or other cloud provider) ───────────────────────
# Uncomment and set these if using CPU-only deployment (VLLM_MODE=cloud)

# VLLM_MODE=cloud
# VLLM_CLOUD_URL=https://api.together.xyz/v1
# VLLM_CLOUD_API_KEY=your_together_ai_api_key_here
# VLLM_MODEL=google/gemma-2b-it

# Alternative: Use OpenAI
# VLLM_MODE=cloud
# VLLM_CLOUD_URL=https://api.openai.com/v1
# VLLM_CLOUD_API_KEY=sk-your_openai_key
# VLLM_MODEL=gpt-4o-mini

# Alternative: Use Ollama (self-hosted)
# VLLM_MODE=cloud
# VLLM_CLOUD_URL=http://your-ollama-server:11434/v1
# VLLM_CLOUD_API_KEY=ollama
# VLLM_MODEL=qwen2.5:3b

# ═══════════════════════════════════════════════════════════════════════════════
# OpenAI API Key (for TTS audio generation)
# ═══════════════════════════════════════════════════════════════════════════════

# Optional: Generate patient voice responses with OpenAI TTS
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# SQLite database path (stored in persistent volume)
DATABASE_URL=/data/medsimulation.db

# ═══════════════════════════════════════════════════════════════════════════════
# Optional: External Service API Keys
# ═══════════════════════════════════════════════════════════════════════════════

# PubMed API (for importing case reports)
# NCBI API key (optional, increases rate limits)
# NCBI_API_KEY=your_ncbi_api_key

# Endless Medical (for diagnostic engine cases)
# ENDLESS_MEDICAL_API_KEY=your_endless_medical_key

# ═══════════════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════════════

# Simulated mode (keyword-based responses, no LLM)
# Set to "true" for testing without any AI
# SIMULATED_MODE=false
