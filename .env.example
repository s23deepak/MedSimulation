# ═══════════════════════════════════════════════════════════════════════════════
# MedSimulation — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to .env and adjust:  cp .env.example .env
# Do not commit .env. For gated Hugging Face models, prefer:
#   huggingface-cli login
# or export HF_TOKEN only in your shell session.

# ── vLLM Inference Mode ───────────────────────────────────────────────────────
# Options: local | cloud | modal
#   local — local OpenAI-compatible vLLM server
#   cloud — remote OpenAI-compatible vLLM/API endpoint
#   modal — Modal RPC mode used by modal_app.py

VLLM_MODE=local

# Application mode: local | demo | production
APP_ENV=local
# Optional password-free local mode. Keep the server bound to 127.0.0.1.
# LOCAL_GUEST_MODE=1
# Password-free hosted pilot: set APP_ENV=demo, ANONYMOUS_ACCESS=1,
# DATABASE_URL, and an explicit HTTPS ALLOWED_ORIGINS. Each browser gets
# a separate cookie-backed learner identity; anyone with the URL can visit.
# ANONYMOUS_ACCESS=1
# Generate PBKDF2 credentials with: python scripts/create_accounts.py
# AUTH_USERS_JSON={"learner":{"role":"learner","password_hash":"pbkdf2$..."},"reviewer":{"role":"reviewer","password_hash":"pbkdf2$..."}}
# Comma-separated explicit origins; HTTPS only in demo/production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Local uses DATABASE_PATH (default data/medsim.db). Hosted modes require Postgres.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/medsimulation

# ── Local vLLM (VLLM_MODE=local) ─────────────────────────────────────────────
VLLM_LOCAL_URL=http://localhost:8001/v1
VLLM_MODEL=google/medgemma-4b-it
# VLLM_PORT=8001  # Optional: custom port for local vLLM server

# ── Cloud vLLM (VLLM_MODE=cloud) ─────────────────────────────────────────────
# Uncomment and configure below for cloud deployment
# Option 1: Modal (Recommended - your own MedGemma, pay-per-use)
#   1. modal.com/signup
#   2. modal token new
#   3. modal deploy modal_vllm.py
#   4. Copy the URL from deployment output
# VLLM_MODE=cloud
# VLLM_CLOUD_URL=https://your-username--medsimulation-vllm-server.modal.run/v1
# VLLM_CLOUD_API_KEY=your-modal-api-key
# VLLM_MODEL=google/medgemma-4b-it

# Option 2: Together AI (cheaper, but no MedGemma - uses Gemma base)
# VLLM_MODE=cloud
# VLLM_CLOUD_URL=https://api.together.xyz/v1
# VLLM_CLOUD_API_KEY=your-together-key
# VLLM_MODEL=google/gemma-2-9b-it
