# ═══════════════════════════════════════════════════════════════════════════════
# MedSimulation — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this to .env and adjust:  cp .env.example .env

# ── vLLM Inference Mode ───────────────────────────────────────────────────────
# Options: simulated | local | cloud
#   simulated — keyword-based fallback (no GPU needed)
#   local     — medgemma-4b-it on local vLLM server
#   cloud     — medgemma-27b-it on RunPod/Modal

VLLM_MODE=local

# ── Local vLLM (VLLM_MODE=local) ─────────────────────────────────────────────
VLLM_LOCAL_URL=http://localhost:8001/v1
# VLLM_MODEL=google/medgemma-4b-it

# ── Cloud vLLM (VLLM_MODE=cloud) ─────────────────────────────────────────────
# Option 1: Modal (Recommended - your own MedGemma, pay-per-use)
#   1. modal.com/signup
#   2. modal token new
#   3. modal deploy modal_vllm.py
#   4. Copy the URL from deployment output
VLLM_MODE=cloud
VLLM_CLOUD_URL=https://your-username--medsimulation-vllm-server.modal.run/v1
VLLM_CLOUD_API_KEY=your-modal-api-key
VLLM_MODEL=google/medgemma-4b-it

# Option 2: Together AI (cheaper, but no MedGemma - uses Gemma base)
# VLLM_MODE=cloud
# VLLM_CLOUD_URL=https://api.together.xyz/v1
# VLLM_CLOUD_API_KEY=your-together-key
# VLLM_MODEL=google/gemma-2-9b-it

# ── Legacy/Backward compat ───────────────────────────────────────────────────
# SIMULATED_MODE=true  # Deprecated — use VLLM_MODE=simulated instead
